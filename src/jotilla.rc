#include <windows.h>
#include "resource.h"
IDI_APP ICON "assets/jotilla.ico"
IDI_APP_HIDDEN ICON "assets/jotilla_hidden.ico"
IDR_LICENSE RCDATA "LICENSE"
IDD_TITLE DIALOGEX 0, 0, 252, 84
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit title"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Title (leave empty to remove):", -1, 10, 9, 230, 12
    EDITTEXT IDC_TITLE, 10, 25, 232, 15, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 130, 58, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 190, 58, 52, 16
END
IDD_TAGS DIALOGEX 0, 0, 292, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit tags"
FONT 9, "Consolas"
BEGIN
    LTEXT "Tags (separate with ;):", -1, 10, 9, 270, 12
    EDITTEXT IDC_TAGS, 10, 25, 272, 16, ES_AUTOHSCROLL
    LTEXT "Used tags - Down to choose, Enter to add:", -1, 10, 49, 272, 12
    LISTBOX IDC_TAG_SUGGESTIONS, 10, 64, 272, 72, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save", IDOK, 170, 153, 52, 16
    PUSHBUTTON "Cancel", IDCANCEL, 230, 153, 52, 16
END
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Alessio Garau\0"
   VALUE "FileDescription", "Jotilla - Tiny Sticky Notes for Windows\0"
   VALUE "FileVersion", APP_VERSION "\0"
   VALUE "InternalName", "Jotilla\0"
   VALUE "OriginalFilename", "Jotilla.exe\0"
   VALUE "ProductName", "Jotilla\0"
   VALUE "ProductVersion", APP_VERSION "\0"
   VALUE "LegalCopyright", "MIT - Alessio Garau\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
